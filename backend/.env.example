# Backend environment variables
# Copy to .env and fill values (do not commit real secrets)

# LLM providers (only Groq + Local Llama)
# Primary provider: 'llama' (LM Studio) or 'groq'
LLM_PROVIDER=llama

# Strict modes (optional): if enabled, the API returns 503 instead of falling back.
# GROQ_REQUIRED=1
# LLAMA_REQUIRED=1

# Local Llama (LM Studio OpenAI-compatible server)
# In LM Studio, enable "OpenAI Compatible Server" (often http://127.0.0.1:1234/v1)
LLAMA_BASE_URL=http://127.0.0.1:1234/v1
LLAMA_API_KEY=lmstudio
LLAMA_MODEL=llama-3.2-1b-instruct

# Groq (OpenAI-compatible endpoint)
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ─── Voix patients (ordre de priorité : ElevenLabs → Google TTS → TTS natif) ──
#
# OPTION 1 — Google Cloud TTS (GRATUIT : 1 million chars/mois)
# Créer un projet sur https://console.cloud.google.com
# Activer l'API "Cloud Text-to-Speech"
# Créer une clé API : APIs & Services → Credentials → Create credentials → API key
# 6 voix Neural2 françaises distinctes selon le profil du patient
GOOGLE_TTS_API_KEY=
# Overrides optionnels des noms de voix Google (valeurs par défaut si vide)
# GTTS_VOICE_GIF1=fr-FR-Neural2-B    # Homme adulte
# GTTS_VOICE_GIF2=fr-FR-Neural2-A    # Femme adulte
# GTTS_VOICE_GIF3=fr-FR-Neural2-D    # Homme senior
# GTTS_VOICE_GIF4=fr-FR-Neural2-C    # Femme senior
# GTTS_VOICE_GIF5=fr-FR-Neural2-B    # Garçon (pitch +5)
# GTTS_VOICE_GIF6=fr-FR-Neural2-A    # Fille (pitch +6)

# OPTION 2 — ElevenLabs (qualité supérieure, 10K chars/mois gratuit)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ELEVENLABS_VOICE_GIF1=  # Homme adulte
# ELEVENLABS_VOICE_GIF2=  # Femme adulte
# ELEVENLABS_VOICE_GIF3=  # Homme senior
# ELEVENLABS_VOICE_GIF4=  # Femme senior
# ELEVENLABS_VOICE_GIF5=  # Garçon enfant
# ELEVENLABS_VOICE_GIF6=  # Fille enfant
